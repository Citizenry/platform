{
  "title": "StreetSignal Platform Documentation",
  "description": "Complete documentation for the StreetSignal Platform",
  "author": "StreetSignal Team",
  "language": "en",
  "root": "./docs",
  "structure": {
    "readme": "README.md",
    "summary": "SUMMARY.md"
  },
  "plugins": [
    "theme-default",
    "search",
    "lunr",
    "sharing",
    "fontsettings",
    "livereload"
  ],
  "pluginsConfig": {
    "theme-default": {
      "showLevel": true
    },
    "sharing": {
      "facebook": false,
      "twitter": false,
      "google": false,
      "weibo": false,
      "instapaper": false,
      "vk": false,
      "all": ["facebook", "google", "twitter", "weibo", "instapaper"]
    }
  },
  "variables": {
    "platform": "StreetSignal Platform",
    "version": "5.x"
  }
}